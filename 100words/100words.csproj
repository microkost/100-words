<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>words100</RootNamespace>
    <AssemblyName>words100</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64;ARM32</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Set to MSIX for Store/packaged builds, None for local unpackaged dev -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">MSIX</WindowsPackageType>
    <DefineConstants Condition="'$(WindowsPackageType)' != 'None'">$(DefineConstants);PACKAGED</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Configurations>Debug;Release</Configurations>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Auto</AppxBundle>
    <AppxBundlePlatforms>x86|x64|arm64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>

  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <!-- MSIX packaging assets - bundled into the package by the MSIX tooling -->
  <ItemGroup>
    <Content Include="Assets\LargeTile310x310Logo.scale-200.png" />
    <Content Include="Assets\SmallTile71x71Logo.scale-200.png" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-32.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\appicon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\flagCZ.png" />
    <Content Include="Assets\flagEN.png" />
    <Content Include="Assets\flagFI.png" />
    <Content Include="Assets\flagPL.png" />
    <Content Include="Assets\dictionary.json" />
  </ItemGroup>

  <!-- Post-build copy: ensure runtime assets land in all three locations VS uses at runtime -->
  <Target Name="CopyRuntimeAssetsToOutput" AfterTargets="Build">
    <ItemGroup>
      <_RuntimeAssets Include="Assets\Square44x44Logo.targetsize-32.png" />
      <_RuntimeAssets Include="Assets\appicon.ico" />
      <_RuntimeAssets Include="Assets\flagCZ.png" />
      <_RuntimeAssets Include="Assets\flagEN.png" />
      <_RuntimeAssets Include="Assets\flagFI.png" />
      <_RuntimeAssets Include="Assets\flagPL.png" />
      <_RuntimeAssets Include="Assets\dictionary.json" />
    </ItemGroup>
    <!-- net8.0 output dir -->
    <MakeDir Directories="$(OutDir)Assets" />
    <Copy SourceFiles="@(_RuntimeAssets)" DestinationFolder="$(OutDir)Assets\" SkipUnchangedFiles="true" />
    <!-- AppX staging dir -->
    <MakeDir Directories="$(OutDir)..\AppX\Assets" Condition="Exists('$(OutDir)..\AppX')" />
    <Copy SourceFiles="@(_RuntimeAssets)" DestinationFolder="$(OutDir)..\AppX\Assets\" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)..\AppX')" />
    <!-- AppX\entrypoint dir - this is AppContext.BaseDirectory at runtime -->
    <MakeDir Directories="$(OutDir)..\AppX\entrypoint\Assets" Condition="Exists('$(OutDir)..\AppX\entrypoint')" />
    <Copy SourceFiles="@(_RuntimeAssets)" DestinationFolder="$(OutDir)..\AppX\entrypoint\Assets\" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)..\AppX\entrypoint')" />
  </Target>
</Project>
